# Copy to .env for local development. On Railway, set these as service variables.
# Never commit real values.

# PostgreSQL connection string (Railway: ${{Postgres.DATABASE_URL}})
DATABASE_URL="postgres://postgres:postgres@localhost:5432/arizon"

# Public URL of the site, no trailing slash. Must be https in production.
APP_URL="http://localhost:3000"

# Two different long random secrets. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=""
OTP_PEPPER=""

# SMS for login codes: "console" (dev only, prints the code in the server log) or "kavenegar"
SMS_PROVIDER="console"
# Only for testing a production deploy before Kavenegar is set up: codes appear in the Railway logs.
ALLOW_CONSOLE_SMS="false"
KAVENEGAR_API_KEY=""
KAVENEGAR_OTP_TEMPLATE=""

# Payments: "mock" (dev only), "zarinpal", or "none" (online payment off, cash on delivery only)
PAYMENT_PROVIDER="mock"
ZARINPAL_MERCHANT_ID=""
ZARINPAL_SANDBOX="false"

# Comma-separated mobile numbers that become ADMIN when they log in, e.g. "09121234567"
ADMIN_PHONES=""

# Where uploaded product images are stored (mount a Railway volume here in production)
UPLOAD_DIR="./storage/uploads"

# "true" when running behind a reverse proxy (Railway, Liara, Nginx) so client IPs are read correctly
TRUST_PROXY="true"
